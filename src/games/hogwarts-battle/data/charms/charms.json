        "trigger": "on_card_played",
        "condition": { "type": "card_type_played_this_turn", "card_type": "spell" },
        "effects": [{ "type": "gain_influence", "params": { "amount": 1, "target": "self" } }]
      },
      {
        "health_threshold": 7,
        "description": "When you play a Spell, gain 1 Attack",
