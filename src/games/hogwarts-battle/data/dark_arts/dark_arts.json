  "relashio": {
    "id": "relashio",
    "name": "Relashio",
    "set": ["game2"],
    "quantity": 1,
    "image": "darkarts/relashio.jpg",
    "description": "All choose: Discard item OR Lose 2 Health",
    "effects": [
      {
        "type": "choose_one_all_players",
        "params": {
          "prompt": "Choose one:",
          "options": [
            {
              "label": "Discard an item",
              "effect": {
                "type": "discard_card_type",
                "params": { "card_type": "item", "target": "self" }
              }
            },
            {
              "label": "Lose 2 Health",
              "effect": { "type": "deal_damage", "params": { "amount": 2, "target": "self" } }
            }
          ]
        }
      }
    ],
    "flavor": "Releases hot sparks from the wand tip."
  },
  "obliviate": {
    "id": "obliviate",
    "name": "Obliviate",
    "set": ["game2"],
    "quantity": 1,
