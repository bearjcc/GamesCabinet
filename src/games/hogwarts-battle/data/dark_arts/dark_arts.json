  "oppugno": {
    "id": "oppugno",
    "name": "Oppugno",
    "set": ["game3"],
    "quantity": 1,
    "image": "darkarts/oppugno.jpg",
    "description": "All reveal top card; if cost > 0, lose 2 Health and discard",
    "effects": [
      {
        "type": "reveal_and_penalty_if_cost",
        "params": {
          "min_cost": 1,
          "penalty": {
            "type": "multi_effect",
            "params": {
              "effects": [
                { "type": "deal_damage", "params": { "amount": 2, "target": "self" } },
                { "type": "discard_revealed_card", "params": {} }
              ]
            }
          },
          "target": "all_players"
        }
      }
    ],
    "flavor": "Causes objects to attack the target."
  },
  "tarantallegra": {
    "id": "tarantallegra",
