      {
        "type": "choose_one_all_players",
        "params": {
          "prompt": "Choose one:",
          "options": [
            {
              "label": "Discard a spell",
              "effect": {
                "type": "discard_card_type",
                "params": { "card_type": "spell", "target": "self" }
