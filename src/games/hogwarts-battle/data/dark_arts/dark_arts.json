  "regeneration": {
    "id": "regeneration",
    "name": "Regeneration",
    "set": ["game4"],
    "quantity": 1,
    "image": "darkarts/regeneration.jpg",
    "description": "Heal all villains 2",
    "effects": [{ "type": "heal_villains", "params": { "amount": 2 } }],
    "flavor": "Bone of the father, flesh of the servant..."
  },
  "avadakedavra": {
    "id": "avadakedavra",
    "name": "Avada Kedavra",
    "set": ["game4"],
    "quantity": 3,
    "image": "darkarts/avadakedavra.jpg",
    "description": "Damage 3 (stun adds location), Reveal 1 more Dark Arts",
    "effects": [
      { "type": "deal_damage", "params": { "amount": 3, "target": "active_player" } },
      {
        "type": "conditional",
        "condition": { "type": "active_player_stunned" },
        "then": { "type": "add_location_control", "params": { "amount": 1 } }
      },
      { "type": "reveal_extra_dark_arts", "params": { "count": 1 } }
    ],
    "flavor": "The Killing Curse."
  },
  "morsmordre": {
    "id": "morsmordre",
    "name": "Morsmordre",
    "set": ["game4"],
    "quantity": 3,
    "image": "darkarts/morsmordre.jpg",
    "description": "Damage all 1, Add 1 location, Check for Death Eater (+1 all damage)",
    "effects": [
      { "type": "deal_damage", "params": { "amount": 1, "target": "all_players" } },
      { "type": "add_location_control", "params": { "amount": 1 } },
      {
        "type": "conditional",
        "condition": { "type": "villain_in_play", "villain_id": "deatheater" },
        "then": { "type": "deal_damage", "params": { "amount": 1, "target": "all_players" } }
      }
    ],
    "flavor": "Conjures the Dark Mark."
  },
  "heirofslytherin": {
    "id": "heirofslytherin",
    "name": "Heir of Slytherin",
    "set": ["game4"],
    "quantity": 2,
    "image": "darkarts/heirofslytherin.jpg",
    "description": "Dice roll: Add location / Heal villains / All discard / Damage all",
    "effects": [
      {
        "type": "roll_outcome_table",
        "params": {
          "outcomes": [
            {
              "min": 0,
              "max": 1,
              "effect": { "type": "add_location_control", "params": { "amount": 1 } },
              "description": "Add 1 control to location"
            },
            {
              "min": 2,
              "max": 3,
              "effect": { "type": "heal_villains", "params": { "amount": 2 } },
              "description": "Heal all villains 2"
            },
            {
              "min": 4,
              "max": 5,
              "effect": {
                "type": "discard_cards",
                "params": { "amount": 1, "target": "all_players", "chooser": "self" }
              },
              "description": "All players discard 1"
            },
            {
              "min": 6,
              "max": 7,
              "effect": {
                "type": "deal_damage",
                "params": { "amount": 1, "target": "all_players" }
              },
              "description": "Damage all players 1"
            }
          ]
        }
      }
    ],
    "flavor": "The heir of Slytherin has returned."
  },
