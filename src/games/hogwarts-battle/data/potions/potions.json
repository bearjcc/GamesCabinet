{
  "calming_draught": {
    "id": "calming_draught",
    "name": "Calming Draught",
    "set": ["potions_box2"],
    "ingredients": ["bicorn_horn", "mandrake_leaf"],
    "effect": {
      "type": "choose_one",
      "params": {
        "prompt": "Choose one:",
        "options": [
          {
            "label": "All Heroes gain 1 Health",
            "effect": { "type": "heal", "params": { "amount": 1, "target": "all_players" } }
          },
          {
            "label": "All Heroes gain 1 Influence",
            "effect": {
              "type": "gain_influence",
              "params": { "amount": 1, "target": "all_players" }
            }
          }
        ]
      },
      "description": "Choose one: All Heroes gain 1 Health OR All Heroes gain 1 Influence"
    },
    "banish_effect": {
      "type": "multi_effect",
      "params": {
        "effects": [
          { "type": "heal", "params": { "amount": 1, "target": "all_players" } },
          { "type": "gain_influence", "params": { "amount": 1, "target": "all_players" } }
        ]
      },
      "description": "All Heroes gain 1 Health and 1 Influence"
    }
  },
