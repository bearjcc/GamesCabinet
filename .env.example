# Server bind (Railway sets PORT automatically)
PORT=8000

# Comma-separated extra CORS origins (localhost defaults always included)
# CORS_ORIGINS=https://your-app.up.railway.app,https://GamesCabi.net

# Postgres match store (Railway Postgres plugin). Omit for in-memory local play.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Or durable flat-file matches on a volume (used when DATABASE_URL is unset)
# FLATFILE_DIR=/data/matches

# Leaderboard JSON path (mount a Railway volume at /data in production)
# SCORES_PATH=/data/scores.json

# Client API / Socket base. Leave empty for same-origin (production).
# VITE_SERVER_URL=
